# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/hl_associates_crm?schema=public"

# Authentication & Session Security
SESSION_SECRET="your-64-character-session-secret-key"

# Encryption Key for sensitive fields at rest (32 bytes hex)
ENCRYPTION_SECRET="your-32-byte-hex-encryption-key"

# Background Job & Cron Security
CRON_SECRET="your-cron-secret-token"

# App & Regional Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
COMPANY_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"
