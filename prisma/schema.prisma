datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  ADMIN
  SALES
}

enum InquiryStatus {
  NEW
  PROFORMA_SENT
  ACCEPTED
  LOST
  REOPENED
  CONVERTED
}

enum InquirySource {
  EXHIBITION
  REFERRAL
  ORGANIC
  WEBSITE
  CONFERENCE
  DIRECT_PARTNER
  OTHER
}

enum ProformaStatus {
  DRAFT
  GENERATING
  READY
  SENDING
  SENT
  FAILED
  RETRYING
  EXPIRED
  CANCELLED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  CHURNED
}

enum ClientServiceStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  RENEWED
  TERMINATED
}

enum RenewalStage {
  SIXTY_DAYS
  THIRTY_DAYS
  SEVEN_DAYS
  EXPIRY_DAY
}

enum RenewalStatus {
  PENDING
  REMINDER_SENT
  RENEWED
  LAPSED
  CANCELLED
}

enum FollowUpType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  OTHER
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EmailCategory {
  PROFORMA
  RENEWAL
  FOLLOW_UP
  PASSWORD_RESET
  SYSTEM
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  RETRYING
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  URGENT
}

enum AuditAction {
  INQUIRY_CREATED
  INQUIRY_UPDATED
  PROFORMA_GENERATED
  PROFORMA_SENT
  INQUIRY_ACCEPTED
  INQUIRY_LOST
  INQUIRY_REOPENED
  CLIENT_CONVERTED
  CLIENT_SERVICE_CREATED
  CLIENT_SERVICE_RENEWED
  RENEWAL_REMINDER_SENT
  EMAIL_FAILED
  SETTINGS_UPDATED
  USER_CREATED
  USER_UPDATED
}

enum AuditEntityType {
  INQUIRY
  CLIENT
  CLIENT_SERVICE
  PROFORMA
  SERVICE
  RENEWAL
  USER
  SETTINGS
}

enum ValidityUnit {
  DAYS
  MONTHS
  YEARS
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  role          RoleName       @default(SALES)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sessions      Session[]
  resetTokens   PasswordResetToken[]
  inquiries     Inquiry[]      @relation("AssignedInquiries")
  clients       Client[]       @relation("AssignedClients")
  followUps     FollowUp[]     @relation("AssignedFollowUps")
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([sessionToken])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model SequenceCounter {
  id           String   @id // e.g. "INQUIRY", "CLIENT", "PROFORMA_2026"
  currentValue Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model Service {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  category          String
  description       String
  detailedScope     String?
  logoUrl           String?
  suggestedPriceMin Decimal?        @db.Decimal(12, 2)
  suggestedPriceMax Decimal?        @db.Decimal(12, 2)
  pricingType       String          @default("FIXED") // FIXED, RANGE, CUSTOM
  defaultDuration   Int             @default(12)
  durationUnit      ValidityUnit    @default(MONTHS)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  inquiries         Inquiry[]
  clientServices    ClientService[]
  proformaItems     ProformaItem[]

  @@index([code])
  @@index([isActive])
}

model Inquiry {
  id                String          @id @default(uuid())
  inquiryNumber     String          @unique // e.g. #INQ-1042
  companyName       String
  contactName       String
  contactTitle      String?
  email             String
  phone             String?
  source            InquirySource   @default(ORGANIC)
  sourceDetail      String?
  status            InquiryStatus   @default(NEW)
  serviceId         String?
  service           Service?        @relation(fields: [serviceId], references: [id])
  serviceScope      String?
  remarks           String?
  assignedToId      String?
  assignedTo        User?           @relation("AssignedInquiries", fields: [assignedToId], references: [id])
  convertedClientId String?
  convertedClient   Client?         @relation("ConvertedFromInquiry", fields: [convertedClientId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  proformas         Proforma[]
  followUps         FollowUp[]
  notes             InquiryNote[]
  activityLogs      ActivityLog[]   @relation("InquiryActivity")

  @@index([status])
  @@index([source])
  @@index([serviceId])
  @@index([assignedToId])
  @@index([createdAt])
}

model InquiryNote {
  id        String   @id @default(uuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inquiryId])
}

model Client {
  id           String          @id @default(uuid())
  clientNumber String          @unique // e.g. #CL-1001
  companyName  String
  logoUrl      String?
  contactName  String
  contactTitle String?
  email        String
  phone        String?
  address      String?
  taxId        String?
  status       ClientStatus    @default(ACTIVE)
  assignedToId String?
  assignedTo   User?           @relation("AssignedClients", fields: [assignedToId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  inquiries    Inquiry[]       @relation("ConvertedFromInquiry")
  services     ClientService[]
  proformas    Proforma[]
  followUps    FollowUp[]
  activityLogs ActivityLog[]   @relation("ClientActivity")

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model ClientService {
  id                  String              @id @default(uuid())
  clientId            String
  client              Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId           String?
  service             Service?            @relation(fields: [serviceId], references: [id])
  serviceNameSnapshot String
  serviceCodeSnapshot String
  scopeSnapshot       String?
  certificateNumber   String?
  startDate           DateTime
  durationValue       Int                 @default(12)
  durationUnit        ValidityUnit        @default(MONTHS)
  expiryDate          DateTime
  status              ClientServiceStatus @default(ACTIVE)
  fee                 Decimal             @db.Decimal(12, 2)
  currency            String              @default("INR")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  renewals            Renewal[]

  @@index([clientId])
  @@index([serviceId])
  @@index([expiryDate])
  @@index([status])
}

model Proforma {
  id             String         @id @default(uuid())
  proformaNumber String         @unique // e.g. PI-2026-0001
  inquiryId      String?
  inquiry        Inquiry?       @relation(fields: [inquiryId], references: [id])
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  status         ProformaStatus @default(DRAFT)
  issueDate      DateTime       @default(now())
  validUntil     DateTime
  subtotal       Decimal        @db.Decimal(12, 2)
  taxRate        Decimal        @db.Decimal(5, 2)
  taxAmount      Decimal        @db.Decimal(12, 2)
  totalAmount    Decimal        @db.Decimal(12, 2)
  currency       String         @default("INR")
  notes          String?
  terms          String?
  pdfUrl         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          ProformaItem[]
  emailEvents    EmailEvent[]

  @@index([inquiryId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model ProformaItem {
  id                   String   @id @default(uuid())
  proformaId           String
  proforma             Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  serviceId            String?
  service              Service? @relation(fields: [serviceId], references: [id])
  serviceNameSnapshot  String
  serviceCodeSnapshot  String
  serviceScopeSnapshot String?
  descriptionSnapshot  String
  quantity             Int      @default(1)
  unitPrice            Decimal  @db.Decimal(12, 2)
  taxRate              Decimal  @db.Decimal(5, 2)
  amount               Decimal  @db.Decimal(12, 2)

  @@index([proformaId])
}

model Renewal {
  id              String        @id @default(uuid())
  clientServiceId String
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)
  stage           RenewalStage
  scheduledDate   DateTime
  status          RenewalStatus @default(PENDING)
  sentAt          DateTime?
  renewedUntil    DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([clientServiceId, stage])
  @@index([clientServiceId])
  @@index([scheduledDate])
  @@index([status])
}

model FollowUp {
  id           String         @id @default(uuid())
  inquiryId    String?
  inquiry      Inquiry?       @relation(fields: [inquiryId], references: [id])
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id])
  assignedToId String
  assignedTo   User           @relation("AssignedFollowUps", fields: [assignedToId], references: [id])
  type         FollowUpType   @default(CALL)
  title        String
  notes        String?
  dueDate      DateTime
  status       FollowUpStatus @default(SCHEDULED)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([inquiryId])
  @@index([clientId])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([status])
}

model EmailEvent {
  id            String        @id @default(uuid())
  category      EmailCategory @default(PROFORMA)
  entityType    String // PROFORMA, RENEWAL, FOLLOW_UP, PASSWORD_RESET
  entityId      String
  proformaId    String?
  proforma      Proforma?     @relation(fields: [proformaId], references: [id])
  recipient     String
  subject       String
  template      String
  status        EmailStatus   @default(QUEUED)
  sentAt        DateTime?
  failureReason String?
  retryCount    Int           @default(0)
  createdAt     DateTime      @default(now())

  @@index([entityType, entityId])
  @@index([proformaId])
  @@index([status])
  @@index([recipient])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  link       String?
  type       NotificationType @default(INFO)
  readAt     DateTime?
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model ActivityLog {
  id          String          @id @default(uuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  action      AuditAction
  entityType  AuditEntityType
  entityId    String
  inquiryId   String?
  inquiry     Inquiry?        @relation("InquiryActivity", fields: [inquiryId], references: [id])
  clientId    String?
  client      Client?         @relation("ClientActivity", fields: [clientId], references: [id])
  beforeState Json?
  afterState  Json?
  description String
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([inquiryId])
  @@index([clientId])
  @@index([createdAt])
}

model CompanySettings {
  id                  String   @id @default("default")
  companyName         String   @default("HL Associates")
  brandTagline        String   @default("Regulatory Compliance & Consulting Services")
  email               String   @default("contact@hlassociates.com")
  phone               String   @default("+91 (022) 2842-1933")
  address             String   @default("100 Compliance Tower, Nariman Point, Mumbai 400021, India")
  taxId               String   @default("GSTIN-27AABCH1234F1Z5")
  currency            String   @default("INR") // Configurable: INR, USD, EUR
  defaultTaxRate      Decimal  @default(18.00) @db.Decimal(5, 2)
  companyTimezone     String   @default("Asia/Kolkata")
  smtpEncryptedConfig String? // AES-256-GCM encrypted JSON: { host, port, user, pass, from }
  isSmtpConfigured    Boolean  @default(false)
  renewalReminderDays String   @default("60,30,7,0")
  updatedAt           DateTime @updatedAt
}
